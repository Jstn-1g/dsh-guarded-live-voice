{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "composite": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@deepseek-ai/dsh-typert-protocol": ["./typert-protocol.d.ts"],
      "@dsh-live-voice/ipc-probe": ["./packages/ipc-probe/src/index.ts"],
      "@dsh-live-voice/ipc-probe/*": ["./packages/ipc-probe/src/*"]
    },
    "skipLibCheck": true
  }
}
