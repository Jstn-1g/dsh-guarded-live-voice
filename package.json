{
  "name": "dsh-live-voice",
  "version": "0.3.0-preview.3",
  "description": "Safety-first DeepSeek Harness live voice preview with exact-session consent and one bounded manual audio turn",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "docs/",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.12.0"
  },
  "packageManager": "pnpm@11.7.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jstn-1g/dsh-live-voice.git"
  },
  "bugs": {
    "url": "https://github.com/Jstn-1g/dsh-live-voice/issues"
  },
  "homepage": "https://github.com/Jstn-1g/dsh-live-voice#readme",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "voice",
    "qwen",
    "privacy"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "pnpm run clean && tsc -p tsconfig.client-types.json && tsdown",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:scripts": "node --check scripts/check-pack.mjs && node --check scripts/clean.mjs && node --check scripts/preflight-windows-desktop.mjs && node --check scripts/smoke-browser-bfcache.mjs && node --check scripts/smoke-browser-unload.mjs && node --check scripts/smoke-harness-alpha-auth.mjs && node --check scripts/smoke-harness-browser-bfcache.mjs && node --check scripts/smoke-harness-fake-qwen.mjs && node --check scripts/verify-windows-desktop-canary.mjs",
    "publint": "publint",
    "pack:check": "node scripts/check-pack.mjs",
    "preflight:desktop:windows": "node scripts/preflight-windows-desktop.mjs",
    "smoke:browser:bfcache": "pnpm run build && node scripts/smoke-browser-bfcache.mjs",
    "smoke:browser:unload": "pnpm run build && node scripts/smoke-browser-unload.mjs",
    "smoke:harness:alpha-auth": "node scripts/smoke-harness-alpha-auth.mjs",
    "smoke:harness:browser:bfcache": "node scripts/smoke-harness-browser-bfcache.mjs",
    "smoke:harness:fake-qwen": "node scripts/smoke-harness-fake-qwen.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run check:scripts && pnpm run build && pnpm run publint && pnpm run pack:check",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "ws": "^8.18.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-client-locale": "^0.1.1-rc.1 || 0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.1-rc.1 || 0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.1-rc.1 || 0.1.2-alpha.1",
    "@deepseek-ai/dsh-credentials": "^0.1.1-rc.1 || 0.1.2-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.1 || 0.1.2-alpha.1",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.1 || 0.1.2-alpha.1",
    "@deepseek-ai/dsh-workspace": "^0.1.1-rc.1 || 0.1.2-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-client-locale": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-workspace": "0.1.1-rc.2",
    "@types/node": "^24.3.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "@types/semver": "^7.8.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.8",
    "lightningcss": "^1.32.0",
    "playwright-core": "1.61.1",
    "publint": "^0.3.24",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "semver": "^7.8.5",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
