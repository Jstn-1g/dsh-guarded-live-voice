{
  "name": "dsh-guarded-live-voice",
  "version": "0.1.0",
  "description": "Host-side protocol and authority foundation for a planned DeepSeek Harness voice plugin",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "docs/",
    "cordis.patch.yml",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jstn-1g/dsh-guarded-live-voice.git"
  },
  "bugs": {
    "url": "https://github.com/Jstn-1g/dsh-guarded-live-voice/issues"
  },
  "homepage": "https://github.com/Jstn-1g/dsh-guarded-live-voice#readme",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "voice",
    "qwen",
    "privacy"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "publint": "publint",
    "pack:check": "node scripts/check-pack.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run publint && pnpm run pack:check",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "ws": "^8.18.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-credentials": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-workspace": "^0.1.1-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-credentials": "0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-workspace": "0.1.1-rc.2",
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.8",
    "publint": "^0.3.24",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
